diff --git a/modules/video_capture/linux/honeycord_v4l2_formate.h b/modules/video_capture/linux/honeycord_v4l2_formate.h
new file mode 100644
index 0000000000..a1eae9ed03
--- /dev/null
+++ b/modules/video_capture/linux/honeycord_v4l2_formate.h
@@ -0,0 +1,87 @@
+// HoneyCord (15.11.2026): Hilfen zur Kamerawahl unter Linux (V4L2).
+//
+// GEMESSEN am UM890 (Logitech Brio, 720p): WebRTC oeffnete die Kamera ueber
+// VGA immer als MJPEG und entpackte jedes Bild auf der CPU — der Erfassungs-
+// Faden kostete bei 30 Bildern/s 7,4 %, bei 60 Bildern/s 16,1 % eines Kerns,
+// obwohl die Brio 720p30 auch unkomprimiert (NV12, YUYV) liefert. Ausserdem
+// zeigte der Waehler die Brio doppelt: ihr Infrarot-Sensor ist ein eigenes
+// /dev/video mit GLEICHER bus_info, kann aber nur Graustufen (GREY).
+#ifndef MODULES_VIDEO_CAPTURE_LINUX_HONEYCORD_V4L2_FORMATE_H_
+#define MODULES_VIDEO_CAPTURE_LINUX_HONEYCORD_V4L2_FORMATE_H_
+
+#include <linux/videodev2.h>
+#include <sys/ioctl.h>
+
+#include <cstdint>
+#include <cstring>
+
+namespace webrtc {
+namespace videocapturemodule {
+
+// Formate, die WebRTC unter Linux verarbeiten kann (wie in StartCapture).
+inline bool HcFormatVerwertbar(uint32_t f) {
+  switch (f) {
+    case V4L2_PIX_FMT_MJPEG: case V4L2_PIX_FMT_JPEG:
+    case V4L2_PIX_FMT_YUV420: case V4L2_PIX_FMT_YVU420:
+    case V4L2_PIX_FMT_YUYV: case V4L2_PIX_FMT_UYVY: case V4L2_PIX_FMT_NV12:
+    case V4L2_PIX_FMT_BGR24: case V4L2_PIX_FMT_RGB24: case V4L2_PIX_FMT_RGB565:
+    case V4L2_PIX_FMT_BGR32: case V4L2_PIX_FMT_RGB32:
+#ifdef V4L2_PIX_FMT_ABGR32
+    case V4L2_PIX_FMT_ABGR32:
+#endif
+#ifdef V4L2_PIX_FMT_ARGB32
+    case V4L2_PIX_FMT_ARGB32:
+#endif
+#ifdef V4L2_PIX_FMT_RGBA32
+    case V4L2_PIX_FMT_RGBA32:
+#endif
+      return true;
+    default:
+      return false;
+  }
+}
+
+// Liefert das Geraet mindestens ein verwertbares Format? Ein Infrarot-Sensor
+// (nur GREY) liefert keines und gehoert weder in die Liste noch geoeffnet.
+inline bool HcNutzbaresGeraet(int fd) {
+  struct v4l2_fmtdesc fmt;
+  memset(&fmt, 0, sizeof(fmt));
+  fmt.type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+  for (fmt.index = 0; ioctl(fd, VIDIOC_ENUM_FMT, &fmt) == 0; fmt.index++) {
+    if (HcFormatVerwertbar(fmt.pixelformat))
+      return true;
+  }
+  return false;
+}
+
+// Liefert das Geraet `fourcc` in genau w x h mit mindestens `fps` Bildern/s?
+// 1 % Spielraum: 1001/30000 (29,97/s, Capture-Karten) zaehlt als 30.
+inline bool HcRateMoeglich(int fd, uint32_t fourcc, int w, int h, int fps) {
+  // Ohne bekannte Wunschrate (0) gilt keine Rohrate als ausreichend (Pruefbefund 4).
+  if (w <= 0 || h <= 0 || fps < 1)
+    return false;
+  struct v4l2_frmivalenum iv;
+  memset(&iv, 0, sizeof(iv));
+  iv.pixel_format = fourcc;
+  iv.width = static_cast<uint32_t>(w);
+  iv.height = static_cast<uint32_t>(h);
+  for (iv.index = 0; ioctl(fd, VIDIOC_ENUM_FRAMEINTERVALS, &iv) == 0; iv.index++) {
+    const struct v4l2_fract* k = nullptr;  // kuerzester Abstand = hoechste Rate
+    if (iv.type == V4L2_FRMIVAL_TYPE_DISCRETE)
+      k = &iv.discrete;
+    else
+      k = &iv.stepwise.min;
+    if (k->numerator > 0 &&
+        static_cast<uint64_t>(k->denominator) * 100 >=
+            static_cast<uint64_t>(fps) * k->numerator * 99)
+      return true;
+    if (iv.type != V4L2_FRMIVAL_TYPE_DISCRETE)
+      break;  // stufenlos/schrittweise: ein Eintrag beschreibt alles
+  }
+  return false;
+}
+
+}  // namespace videocapturemodule
+}  // namespace webrtc
+
+#endif  // MODULES_VIDEO_CAPTURE_LINUX_HONEYCORD_V4L2_FORMATE_H_
