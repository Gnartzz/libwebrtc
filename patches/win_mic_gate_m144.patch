     // e.g. Android).
-    if (options_.init_recording_on_send.value_or(true) &&
+    // HoneyCord (#62): nur hochfahren, wenn wirklich ein Mikrofon-Track
+    // sendet - nicht bei reinem Bildschirm-Ton (Custom-Quelle).
+    const bool has_real_mic_source =
+        std::any_of(send_streams_.begin(), send_streams_.end(),
+                    [](const auto& kv) { return kv.second->HasRealMicSource(); });
+    if (has_real_mic_source &&
+        options_.init_recording_on_send.value_or(true) &&
         // InitRecording() may return an error if the ADM is already recording.
         !engine()->adm()->RecordingIsInitialized() &&
         !engine()->adm()->Recording()) {
@@ -1774,9 +1790,24 @@
         std::none_of(send_streams_.begin(), send_streams_.end(),
                      [](const auto& kv) { return kv.second->HasSource(); });
 
+    // HoneyCord (#62): wie is_all_no_source, aber Custom-Quellen (Bildschirm-
+    // Ton) zaehlen als "kein Mikrofon".
+    bool is_all_no_mic_source =
+        std::none_of(send_streams_.begin(), send_streams_.end(),
+                     [](const auto& kv) { return kv.second->HasRealMicSource(); });
+
     bool is_all_muted =
         std::all_of(send_streams_.begin(), send_streams_.end(),
                     [](const auto& kv) { return kv.second->IsMuted(); });
+
+    // HoneyCord (#62): Stummschalt-Zustand NUR ueber echte Mikrofon-Streams.
+    // Ein laufender Bildschirm-Ton-Stream ist nie stumm und wuerde sonst das
+    // Mikrofon aufreissen, obwohl der Nutzer stumm ist. Ohne Custom-Quellen
+    // ist dieser Wert identisch mit is_all_muted -> Verhalten unveraendert.
+    bool is_all_mic_muted = std::all_of(
+        send_streams_.begin(), send_streams_.end(), [](const auto& kv) {
+          return !kv.second->HasRealMicSource() || kv.second->IsMuted();
+        });
 
