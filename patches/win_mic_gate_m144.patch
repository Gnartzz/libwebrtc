+  // oeffnet (Windows senkt sonst alle anderen Apps ab; macOS: A2DP->HFP).
+  bool HasRealMicSource() const {
+    RTC_DCHECK_RUN_ON(&worker_thread_checker_);
+    return source_ != nullptr && !source_->IsCustomSource();
+  }
+
   // Stops sending by setting the sink of the AudioSource to nullptr. No data
   // callback will be received after this method.
   // This method is called on the libjingle worker thread.
@@ -1561,7 +1571,13 @@
 
