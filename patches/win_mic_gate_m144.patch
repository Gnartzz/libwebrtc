   }
 
--- a/pc/rtp_sender.h
+++ b/pc/rtp_sender.h
@@ -332,11 +332,19 @@
 
   // webrtc::AudioSource implementation.
   void SetSink(AudioSource::Sink* sink) override;
+  bool IsCustomSource() const override { return custom_source_; }
+
+ public:
+  // HoneyCord (#62/Windows): wird vom AudioRtpSender gesetzt, wenn der Track
+  // aus einer Custom-Quelle (Bildschirm-Ton) gespeist wird.
+  void SetCustomSource(bool custom) { custom_source_ = custom; }
 
+ private:
   AudioSource::Sink* sink_;
   // Critical section protecting `sink_`.
   Mutex lock_;
   int num_preferred_channels_ = -1;
+  bool custom_source_ = false;
 };
 
 class AudioRtpSender : public DtmfProviderInterface, public RtpSenderBase {
--- a/pc/rtp_sender.cc
+++ b/pc/rtp_sender.cc
@@ -754,6 +754,14 @@
 void AudioRtpSender::AttachTrack() {
   RTC_DCHECK(track_);
   cached_track_enabled_ = track_->enabled();
+  // HoneyCord (#62/Windows): Quellen, die ihre Abtastwerte selbst liefern
+  // (Bildschirm-Ton), am Sink-Adapter markieren. WebRtcVoiceSendChannel nutzt
+  // die Markierung, damit reiner Bildschirm-Ton nicht die Mikrofon-Aufnahme
+  // hochfaehrt (Windows senkt sonst alle anderen Apps ab, "Ducking").
+  // Bei jedem Anhaengen neu bestimmt -> ein wiederverwendeter Sender behaelt
+  // die Markierung eines alten Tracks nicht.
+  sink_adapter_->SetCustomSource(audio_track()->GetSource() != nullptr &&
+                                 audio_track()->GetSource()->IsCustomSource());
   audio_track()->AddSink(sink_adapter_.get());
 }
 
