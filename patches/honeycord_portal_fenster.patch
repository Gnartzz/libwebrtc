-      g_variant_new_uint32(static_cast<uint32_t>(capture_source_type_)));
+  // HoneyCord (22.11.2026, Fenster unter Wayland): nur Quelltypen erfragen,
+  // die der Desktop anbietet (Eigenschaft AvailableSourceTypes, 1 Bildschirm,
+  // 2 Fenster, 4 virtuell). xdg-desktop-portal lehnt SelectSources mit einem
+  // nicht angebotenen Typ ab („Unsupported device type“) — ein Desktop ohne
+  // Fenster-Aufnahme bekaeme bei „Bildschirm oder Fenster“ sonst gar nichts.
+  // Ohne lesbare Eigenschaft bleibt es beim Bildschirm (alter Weg).
+  uint32_t types = static_cast<uint32_t>(capture_source_type_);
+  {
+    const uint32_t gewuenscht = types;
+    uint32_t angeboten = 0;
+    bool bekannt = false;
+    Scoped<GVariant> available(
+        g_dbus_proxy_get_cached_property(proxy_, "AvailableSourceTypes"));
+    if (available.get() &&
+        g_variant_is_of_type(available.get(), G_VARIANT_TYPE_UINT32)) {
+      g_variant_get(available.get(), "u", &angeboten);
+      bekannt = true;
+    }
+    if (bekannt && angeboten) {
+      types &= angeboten;
+      if (!types)
+        types = static_cast<uint32_t>(CaptureSourceType::kScreen);
+    } else if (types & static_cast<uint32_t>(CaptureSourceType::kWindow)) {
+      types = static_cast<uint32_t>(CaptureSourceType::kScreen);
+    }
+    RTC_LOG(LS_INFO) << "ScreenCast types: gewuenscht=" << gewuenscht
+                     << " angeboten=" << (bekannt ? (int)angeboten : -1)
+                     << " gesendet=" << types;
+    if (libwebrtc::Protokoll)
+      libwebrtc::Protokoll(
+          "Portal: Quelltypen gewuenscht=%u angeboten=%d gesendet=%u "
+          "(1 Bildschirm, 2 Fenster, 4 virtuell)",
+          gewuenscht, bekannt ? (int)angeboten : -1, types);
+  }
+  g_variant_builder_add(&builder, "{sv}", "types",
+                        g_variant_new_uint32(types));
   // We don't want to allow selection of multiple sources.
   g_variant_builder_add(&builder, "{sv}", "multiple",
                         g_variant_new_boolean(false));
