+++ b/modules/desktop_capture/linux/wayland/honeycord_dmabuf.h
@@ -0,0 +1,65 @@
+/*
+ * HoneyCord (Null-Kopie Linux, 08.11.2026): Haken zwischen dem PipeWire-
+ * Aufnehmer und der Grafikkarte.
+ *
+ * Ohne Haken liest WebRTC jedes DMA-BUF-Bild per glReadPixels in den
+ * Arbeitsspeicher, danach rechnet die CPU es zweimal um und laedt es wieder
+ * hoch (gemessen auf Intel UHD 630: 5-10 ms CPU je Bild). Ist ein Wandler
+ * gesetzt, bekommt er den DMA-BUF zuerst; liefert er ein GPU-Bild, haengt es
+ * am DesktopFrame (honeycord_nativ) und die Pixel werden NICHT gelesen.
+ * Liefert er nullptr, laeuft alles wie bisher.
+ */
+#ifndef MODULES_DESKTOP_CAPTURE_LINUX_WAYLAND_HONEYCORD_DMABUF_H_
+#define MODULES_DESKTOP_CAPTURE_LINUX_WAYLAND_HONEYCORD_DMABUF_H_
+
+#include <stdint.h>
+
+#include <atomic>
+
+#include "api/ref_count.h"
+#include "api/scoped_refptr.h"
+
+namespace webrtc {
+
+struct HcDmaBufEbene {
+  int fd = -1;
+  uint32_t offset = 0;
+  uint32_t stride = 0;
+};
+
+struct HcDmaBufBild {
+  int strom_breite = 0;      // Groesse des DMA-BUF
+  int strom_hoehe = 0;
+  int x = 0, y = 0;          // Ausschnitt (VideoCrop), sonst 0/0 und volle Groesse
+  int breite = 0, hoehe = 0;
+  uint32_t spa_format = 0;   // SPA_VIDEO_FORMAT_*
+  uint64_t modifier = 0;     // DRM_FORMAT_MOD_INVALID = implizit
+  int ebenen = 0;
+  HcDmaBufEbene ebene[4];
+};
+
+class HcDmaBufWandler {
+ public:
+  // Muss FERTIG sein, wenn es zurueckkehrt: Der PipeWire-Puffer geht danach
+  // an den Compositor zurueck und wird neu beschrieben.
+  virtual scoped_refptr<RefCountInterface> Wandeln(const HcDmaBufBild& bild) = 0;
+
+  // Wahr, wenn dieser Modifier dauerhaft nicht zu uebernehmen ist. Dann
+  // streicht der Aufnehmer ihn (wie bei einem EGL-Fehler) und verhandelt neu,
+  // solange noch ein anderer fester Modifier bleibt -- sonst liefe die ganze
+  // Freigabe ueber die CPU, nur weil der Compositor zuerst diesen gewaehlt hat.
+  virtual bool ModifierUnbrauchbar(uint64_t modifier) = 0;
+
+ protected:
+  virtual ~HcDmaBufWandler() = default;
+};
+
+// Einmal je Prozess gesetzt, lebt bis zum Ende (wird nie freigegeben).
+inline std::atomic<HcDmaBufWandler*>& HcDmaBufWandlerPlatz() {
+  static std::atomic<HcDmaBufWandler*> platz{nullptr};
+  return platz;
+}
+
+}  // namespace webrtc
+
+#endif  // MODULES_DESKTOP_CAPTURE_LINUX_WAYLAND_HONEYCORD_DMABUF_H_
